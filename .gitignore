node_modules/
package-lock.json

# EPUB build artifacts
en/source-v2-rendered.html
fr/source-v2-rendered.html
# Claude Code, append these lines to your existing .gitignore.
# Version the team-shared files, ignore local logs and personal overrides.

# Default: ignore everything under .claude/
.claude/*

# Whitelist team-shared subdirectories and the main settings file
!.claude/agents/
!.claude/commands/
!.claude/hooks/
!.claude/agent-memory/
!.claude/settings.json

# Optional: whitelist your custom docs (uncomment if you create these)
# !.claude/COMMANDS.md
# !.claude/PATTERNS.md
# !.claude/STACK.md
# !.claude/CONVENTIONS.md
# !.claude/WORKFLOW.md

# Activity log, local debug only, never commit
.claude/logs/

# Personal settings overrides (per-machine secrets, webhook URLs)
.claude/settings.local.json

# Personal memo (your lessons learned, gotchas discovered)
.claude/CLAUDE.local.md

# Coach mute flag, machine-local
.claude/coach-mute

# Local-scope agent memory (sensitive knowledge that shouldn't be versioned)
.claude/agent-memory-local/
